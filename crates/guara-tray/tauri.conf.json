{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guara Tray",
  "version": "0.1.0",
  "identifier": "dev.guara.tray",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "palette",
        "title": "Guará quick search",
        "width": 720,
        "height": 460,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray-idle.png",
      "tooltip": "Guará"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/tray-idle.png"]
  }
}